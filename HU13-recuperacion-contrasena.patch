+  <div class="col-sm-10 col-md-7 col-lg-5">
+    <div class="card shadow-sm">
+      <div class="card-body p-4">
+        <h1 class="h3 mb-3">Crear contraseña nueva</h1>
+
+        @switch (estado()) {
+          @case ('verificando') {
+            <div class="d-flex align-items-center gap-2 text-secondary" role="status">
+              <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
+              Verificando el enlace...
+            </div>
+          }
+
+          @case ('invalido') {
+            <div class="alert alert-warning" role="alert">{{ mensajeEnlaceInvalido }}</div>
+            <div class="d-grid">
+              <a routerLink="/recuperar" class="btn btn-success">Solicitar un enlace nuevo</a>
+            </div>
+          }
+
+          @case ('valido') {
+            @if (errorEnvio()) {
+              <div class="alert alert-danger" role="alert">{{ errorEnvio() }}</div>
+            }
+
+            <form [formGroup]="form" (ngSubmit)="guardar()" novalidate>
+              <div class="mb-3">
+                <label for="password" class="form-label">Contraseña nueva</label>
+                <input
+                  id="password"
+                  type="password"
+                  class="form-control"
+                  formControlName="password"
+                  autocomplete="new-password"
+                  aria-describedby="ayudaPassword"
+                  [class.is-invalid]="passwordConError"
+                />
+                @if (passwordConError) {
+                  <div class="invalid-feedback">Usa 8 caracteres o más, con letras y números</div>
+                } @else {
+                  <div id="ayudaPassword" class="form-text">
+                    Mínimo 8 caracteres, con letras y números.
+                  </div>
+                }
+              </div>
+
+              <div class="mb-3">
+                <label for="confirmacion" class="form-label">Repite la contraseña nueva</label>
+                <input
+                  id="confirmacion"
+                  type="password"
+                  class="form-control"
+                  formControlName="confirmacion"
+                  autocomplete="new-password"
+                  [class.is-invalid]="confirmacionConError"
+                />
+                @if (confirmacionConError) {
+                  <div class="invalid-feedback">
+                    {{
+                      form.controls.confirmacion.hasError('required')
+                        ? 'Repite la contraseña nueva'
+                        : 'Las contraseñas no coinciden'
+                    }}
+                  </div>
+                }
+              </div>
+
+              <div class="d-grid">
+                <button type="submit" class="btn btn-success" [disabled]="enviando()">
+                  @if (enviando()) {
+                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
+                    Guardando...
+                  } @else {
+                    Guardar contraseña
+                  }
+                </button>
+              </div>
+            </form>
+          }
+        }
+      </div>
+    </div>
+  </div>
+</div>
